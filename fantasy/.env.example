# Copy to .env.local (git-ignored). Needed from Phase 3 on; demo mode needs nothing.
# EXPO_PUBLIC_* values are compiled into the app and are PUBLIC. Never put a
# service-role key or a football API key here: those live in Supabase Edge
# Function secrets (supabase secrets set ...).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
