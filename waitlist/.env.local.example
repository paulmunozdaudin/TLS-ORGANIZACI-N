# Copia este archivo a .env.local y rellénalo.
# Supabase > Project Settings > API.

# URL del proyecto de Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave "service_role" (secreta: solo se usa en el servidor, nunca la publiques).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Texto aleatorio para cifrar las IPs del límite de envíos (p. ej. `openssl rand -hex 16`).
IP_HASH_SALT=cambia-esto

# URL pública (opcional en Vercel: si falta, se usa el dominio de producción).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
