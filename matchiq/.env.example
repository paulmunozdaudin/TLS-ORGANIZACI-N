# App configuration. Copy to .env.local (git-ignored).
# EXPO_PUBLIC_* values are compiled into the app and are PUBLIC: only the
# Supabase project URL and anon key belong here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Provider keys are NOT app configuration. Set them as Edge Function secrets:
#   supabase secrets set API_FOOTBALL_KEY=... THE_ODDS_API_KEY=... CRON_SECRET=...
