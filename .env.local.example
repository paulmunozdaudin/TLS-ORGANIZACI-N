# Copia este archivo a .env.local y rellena con los datos de tu proyecto de
# Supabase (Settings > API en el panel de Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Slug del workspace compartido (creado por supabase/schema.sql). No suele
# hacer falta cambiarlo.
NEXT_PUBLIC_WORKSPACE_SLUG=tls
